{
  "meta": {
    "name": "奢游国际行程长图设计变量",
    "version": "1.0.0",
    "source": "行程单满意版本.png + 品牌规范",
    "canvas": { "masterWidth": 2000, "shareWidth": 1080, "height": "auto" }
  },
  "color": {
    "sparkleGold": "#D4BA9A",
    "freeGold": "#B28B33",
    "goldDeep": "#8D6827",
    "goldLight": "#E9D8BE",
    "warmWhite": "#FBF8F2",
    "paper": "#FFFDFC",
    "ink": "#4B433A",
    "muted": "#7D746A",
    "line": "#E7D7C0",
    "warning": "#D98245",
    "success": "#6D876D"
  },
  "layout": {
    "pageMargin": 96,
    "contentWidth": 1808,
    "gridColumns": 12,
    "gutter": 32,
    "sectionGap": 112,
    "cardGap": 28
  },
  "radius": { "sm": 18, "md": 30, "lg": 48, "pill": 999 },
  "shadow": {
    "card": "0 14px 40px rgba(111,78,33,.09)",
    "soft": "0 24px 80px rgba(178,139,51,.12)"
  },
  "stroke": { "hairline": 2, "icon": 2, "card": 2 },
  "spacing": { "xs": 12, "sm": 20, "md": 32, "lg": 48, "xl": 72, "xxl": 112 },
  "type": {
    "display": { "size": 88, "lineHeight": 1.15, "weight": 700 },
    "h1": { "size": 68, "lineHeight": 1.2, "weight": 700 },
    "h2": { "size": 54, "lineHeight": 1.25, "weight": 700 },
    "h3": { "size": 40, "lineHeight": 1.3, "weight": 700 },
    "body": { "size": 30, "lineHeight": 1.75, "weight": 400 },
    "small": { "size": 24, "lineHeight": 1.55, "weight": 400 },
    "caption": { "size": 20, "lineHeight": 1.45, "weight": 400 }
  },
  "image": {
    "heroRatio": "16/9",
    "singleRatio": "16/9",
    "gridRatio": "4/3",
    "objectFit": "cover",
    "objectPosition": "50% 50%"
  },
  "rules": {
    "maxBodyCharsBeforeExpand": 220,
    "neverShrinkBodyBelow": 26,
    "dayKeepTogether": true,
    "hideEmptyFields": true
  }
}
